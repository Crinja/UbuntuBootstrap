#!/usr/bin/env bash
set -euo pipefail

cat <<'EOF'
Ubuntu workstation helpers

Common commands:
  ws-new <template> <project-name> [options]
      Create a project-scoped Distrobox.
      Use --with-devcontainer for templates and host Podman Dev Containers integration.
      Use --with-podman to enable host Podman integration for an existing project.
      Use --with-claude, --with-codex, or --with-ai for project-local AI tools.

  ws-enter <project-name>
      Enter the project Distrobox and start in the project folder.

  ws-list
      List project environments.

  ws-remove <project-name>
      Remove a project Distrobox after confirmation.

  ws-code <project-name> [code-args...]
      Launch the VS Code Flatpak with project-specific settings/extensions.
      Integrated terminals enter the matching project Distrobox.

  ws-ai-add <project-name> --claude|--codex|--all
      Add project-local Claude Code and/or Codex CLI to an existing project box.

Templates:
  rust rust-nightly cpp csharp dotnet java js node python php generic

Examples:
  ws-new rust ExampleProject
  ws-new dotnet ApiExample --with-devcontainer
  ws-new rust AgentProject --with-claude
  ws-new node WebExample
  ws-new python HeadlessScript
  ws-new cpp EngineExperiment
  ws-new rust-nightly CompilerExperiment
  ws-enter ExampleProject
  ws-code ExampleProject
  ws-ai-add ExampleProject --codex
  ws-enter ExampleProject
  claude
  codex
  ws-list
  ws-remove ExampleProject

Project layout:
  Source:    ~/Projects/<project-name>
  Box home:  ~/Boxes/projects/<project-name>
  Box name:  project-<normalized-project-name>
EOF
